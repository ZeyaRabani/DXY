# Copy to .env.local (local dev) and set the same vars in Vercel for deployment.

# Public Supabase project URL and publishable/anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only secret/service_role key (never exposed to the browser).
# Used by the daily cron route for upserts.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Database password — only used by the local import/schema scripts (scripts/).
SUPABASE_DB_PASSWORD=your-db-password
# Optional: full Postgres connection string override (e.g. the Supabase pooler
# host for IPv4-only networks). If set, the scripts use this verbatim.
# SUPABASE_DB_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Protects the /api/cron/daily-update route. Vercel Cron sends this automatically.
CRON_SECRET=generate-a-long-random-string

# Free LLM for the V2 AI assistant. It only translates natural language into a
# database query plan and narrates the EXACT numbers we compute — it never
# calculates statistics, so it cannot hallucinate figures. If no key is set the
# deterministic parser + templated answer are used as a fallback (still works).
# Provider is auto-detected in this order: Gemini, Groq, OpenRouter, Ollama.
# Set LLM_PROVIDER to force one. Only ONE key is needed.
# GEMINI_API_KEY=...            # https://aistudio.google.com/apikey  (free)
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_API_KEY=gsk_...          # https://console.groq.com/keys       (free)
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=sk-or-...  # https://openrouter.ai/keys          (free tier)
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_PROVIDER=groq             # gemini | groq | openrouter | ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
